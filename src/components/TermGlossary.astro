---
export interface GlossaryTerm {
  term: string;
  def: string;
}

interface Props {
  terms: GlossaryTerm[];
  intro?: string;
}

const { terms, intro = 'These are common terms used throughout this website.' } = Astro.props;
---

<div class="term-block">
  <p class="term-intro">{intro}</p>
  <div class="term-grid">
    {terms.map((item) => (
      <button type="button" class="term-flip" aria-label={item.term}>
        <span class="term-flip-inner">
          <span class="term-face term-front">{item.term}</span>
          <span class="term-face term-back">{item.def}</span>
        </span>
      </button>
    ))}
  </div>
</div>

<style>
  .term-block {
    margin: 0 0 40px;
  }
  .term-intro {
    font-size: 17px;
    color: #5a5a5a;
    margin: 0 0 16px;
  }
  .term-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .term-flip {
    display: block;
    width: 100%;
    height: 132px;
    perspective: 800px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
  .term-flip-inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 0.45s ease;
    transform-style: preserve-3d;
  }
  @media (hover: hover) and (pointer: fine) {
    .term-flip:hover .term-flip-inner {
      transform: rotateY(180deg);
    }
  }
  .term-flip.is-flipped .term-flip-inner,
  .term-flip:focus-visible .term-flip-inner {
    transform: rotateY(180deg);
  }
  .term-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: #f3f3f3;
    border: 1px solid #d2d2d2;
    padding: 18px 16px;
    box-shadow: 0 4px 12px -8px rgba(0,0,0,0.1);
  }
  .term-front {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
    display: flex;
    align-items: center;
  }
  .term-back {
    transform: rotateY(180deg);
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 18px;
    line-height: 1.5;
    color: #2e2e2e;
  }
  @media (max-width: 700px) {
    .term-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll('.term-flip').forEach((card) => {
    card.addEventListener('click', () => card.classList.toggle('is-flipped'));
  });
</script>

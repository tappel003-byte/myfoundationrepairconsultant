---
export interface GlossaryTerm {
  term: string;
  def: string;
}

interface Props {
  terms: GlossaryTerm[];
  intro?: string;
}

const { terms, intro = 'These are common terms used throughout this website.' } = Astro.props;
---

<div class="term-block">
  <p class="term-intro">{intro}</p>
  <div class="term-grid">
    {terms.map((item) => (
      <div class="term-card">
        <h3 class="term-name">{item.term}</h3>
        <p class="term-def">{item.def}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .term-block {
    margin: 0 0 40px;
  }
  .term-intro {
    font-size: 17px;
    color: #5a5a5a;
    margin: 0 0 16px;
  }
  .term-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .term-card {
    background: #f3f3f3;
    border: 1px solid #d2d2d2;
    padding: 18px 16px;
    min-height: 132px;
  }
  .term-name {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 8px;
    line-height: 1.2;
  }
  .term-def {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 16px;
    line-height: 1.5;
    color: #2e2e2e;
    margin: 0;
  }
  @media (max-width: 700px) {
    .term-grid { grid-template-columns: 1fr; }
    .term-card { min-height: 0; }
  }
</style>

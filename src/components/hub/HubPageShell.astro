---
interface GlanceItem {
  label: string;
  value: string;
}

interface NavItem {
  id: string;
  label: string;
}

interface Props {
  title: string;
  subhead: string;
  bannerBlurb?: string;
  description?: string;
  glance?: GlanceItem[];
  nav: NavItem[];
  showFloatingNav?: boolean;
  topicsStyle?: 'box' | 'list' | 'none';
}

const {
  title,
  subhead,
  bannerBlurb,
  description,
  glance,
  nav,
  showFloatingNav = true,
  topicsStyle = 'list',
} = Astro.props;
---

<div class="hub-wrap">
  {showFloatingNav && (
    <div class="floating-nav" id="floatingNav">
      <a href="#topics" class="top-link"><span>↑</span> Topics</a>
      <span class="nav-divider">|</span>
      <a href="#" id="floatingTopLink" class="top-link"><span>↑↑</span> Top</a>
    </div>
  )}

  <section class="hero-banner" aria-label="Page title">
    <div class="hero-banner-inner">
      <h1>{title}</h1>
      {bannerBlurb ? <p class="hero-blurb">{bannerBlurb}</p> : <p class="hero-blurb">{subhead}</p>}
    </div>
  </section>

  <div class="page page-redesign">
    {description && <p class="page-lede">{description}</p>}

    {glance && glance.length > 0 && (
      <div class="glance" aria-label="At a glance">
        {glance.map((item) => (
          <div class="glance-item">
            <strong>{item.label}</strong>
            {item.value}
          </div>
        ))}
      </div>
    )}

    <slot name="before-topics" />

    {topicsStyle === 'list' && (
      <nav class="topics-list" id="topics" aria-label="Topics">
        <h2 class="topics-list-heading">Topics</h2>
        {nav.map((item) => (
          <a href={`#${item.id}`}>{item.label}</a>
        ))}
      </nav>
    )}
    {topicsStyle === 'box' && (
      <nav class="quick-nav" id="topics" aria-label="On this page">
        {nav.map((item) => (
          <a href={`#${item.id}`}>{item.label}</a>
        ))}
      </nav>
    )}
    {topicsStyle === 'none' && <div id="topics" class="section-anchor" />}

    <div class="redesign-body">
      <slot />
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.accordion-header').forEach((header) => {
    header.addEventListener('click', () => header.parentElement?.classList.toggle('active'));
  });

  document.querySelectorAll('.accordion-content-inner').forEach((inner) => {
    if (inner.querySelector('.back-to-topics')) return;
    const link = document.createElement('a');
    link.href = '#topics';
    link.className = 'back-to-topics';
    link.textContent = 'Back to topics';
    inner.appendChild(link);
  });

  const openTarget = (id) => {
    if (!id) return;
    const target = document.getElementById(id);
    if (!target) return;
    const section = target.classList.contains('accordion-section')
      ? target
      : target.closest('.accordion-section');
    section?.classList.add('active');
    (section || target).scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  document.querySelectorAll('.topics-list a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = link.getAttribute('href') || '';
      const id = href.slice(1);
      if (!id) return;
      event.preventDefault();
      openTarget(id);
      history.replaceState(null, '', href);
    });
  });

  if (window.location.hash) {
    openTarget(window.location.hash.slice(1));
  }

  const floatingNav = document.getElementById('floatingNav');
  const hero = document.querySelector('.hero-banner');
  const topLink = document.getElementById('floatingTopLink');

  if (floatingNav && hero) {
    window.addEventListener('scroll', () => {
      floatingNav.classList.toggle('visible', window.scrollY > hero.offsetHeight);
    });
    topLink?.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

---
const nav = [
  { label: 'Start Here', href: '/start-here' },
  { label: 'How the Industry Has Changed', href: '/how-the-industry-has-changed' },
  {
    label: 'Technical References',
    children: [
      { label: 'Foundation Repair Dictionary', href: '/foundation-repair-dictionary' },
      { label: 'Foundation Types', href: '/foundation-types' },
      { label: 'Material Behavior', href: '/material-behavior' },
      { label: 'Common Signs', href: '/common-signs' },
    ],
  },
  {
    label: 'Knowledge Center',
    children: [
      { label: 'Educational Articles', href: '/educational-articles' },
      { label: 'Industry Articles', href: '/industry-articles' },
      { label: 'All Articles', href: '/all-articles' },
    ],
  },
  {
    label: 'Repair Methods',
    children: [
      { label: 'Overview', href: '/repair-methods' },
      { label: 'Helical Piers', href: '/helical-piers' },
      { label: 'Micropiles', href: '/micropiles' },
      { label: 'Push Piers', href: '/push-piers' },
      { label: 'Compaction Grouting', href: '/compaction-grouting' },
      { label: 'Foam Jacking', href: '/foam-jacking' },
      { label: 'Other Deep Foundations', href: '/other-deep-foundations' },
      { label: 'Field Notes', href: '/foundation-field-notes' },
    ],
  },
  {
    label: 'New Mexico',
    children: [
      { label: 'Foundation Behavior in NM', href: '/foundation-behavior-in-new-mexico' },
      { label: 'NM Soil Conditions', href: '/new-mexico-soil-conditions' },
      { label: 'Investigate Further', href: '/investigate-further' },
    ],
  },
  {
    label: 'Arizona',
    children: [
      { label: 'Know Before You Sign', href: '/know-before-you-sign' },
      { label: 'Foundation Behavior in AZ', href: '/foundation-behavior-in-arizona' },
      { label: 'Investigate Further', href: '/investigate-further-arizona' },
    ],
  },
];
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-logo" href="/start-here">
      <img
        class="site-logo-img"
        src="/mfrc-logo.jpg"
        alt="MFRC — My Foundation Repair Consultant"
        width="220"
        height="139"
      />
    </a>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" id="navToggle">
      Menu
    </button>
    <nav class="site-nav" id="siteNav" aria-label="Main">
      <ul class="nav-list">
        {nav.map((item) => (
          <li class={item.children ? 'nav-item nav-dropdown' : 'nav-item'}>
            {item.children ? (
              <>
                <span class="nav-parent">{item.label}</span>
                <ul class="nav-menu">
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav-dropdown.open > .nav-menu {
    display: block;
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('siteNav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  document.querySelectorAll('.nav-dropdown').forEach((item) => {
    let closeTimer;
    const open = () => {
      clearTimeout(closeTimer);
      document.querySelectorAll('.nav-dropdown.open').forEach((other) => {
        if (other !== item) other.classList.remove('open');
      });
      item.classList.add('open');
    };
    const closeSoon = () => {
      closeTimer = setTimeout(() => item.classList.remove('open'), 350);
    };
    item.addEventListener('mouseenter', open);
    item.addEventListener('mouseleave', closeSoon);
    item.querySelector('.nav-parent')?.addEventListener('click', (event) => {
      event.preventDefault();
      if (item.classList.contains('open')) item.classList.remove('open');
      else open();
    });
  });
</script>

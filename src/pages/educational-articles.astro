---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubPageShell from '../components/hub/HubPageShell.astro';
import { cleanTitle } from '../lib/pages';

const groups = [
  {
    id: 'movement',
    label: 'Movement and settlement',
    links: [
      { href: '/all-articles/settlement', title: 'Settlement: What It Means' },
      { href: '/all-articles/differential-settlement-why-uneven-movement-matters-more-than-movement-itself', title: 'Differential Settlement' },
      { href: '/all-articles/foundation-problem-vs-normal-settling-how-to-evaluate-what-youre-seeing', title: 'Foundation Problem vs. Normal Settling' },
      { href: '/all-articles/foundationcracks', title: 'Foundation Cracks' },
      { href: '/all-articles/structuralcracks', title: 'Structural Cracks' },
    ],
  },
  {
    id: 'soils',
    label: 'Soils and climate',
    links: [
      { href: '/all-articles/expansivesoil', title: 'Expansive Soil' },
      { href: '/all-articles/collapsiblesoil', title: 'Collapsible Soil' },
      { href: '/all-articles/soil-reports-what-they-are-and-what-theyre-actually-used-for', title: 'Soil Reports' },
      { href: '/all-articles/why-soil-analysis-matters-in-understanding-structural-performance', title: 'Why Soil Analysis Matters' },
      { href: '/all-articles/how-climate-and-weather-affect-foundation-stability', title: 'Climate and Weather' },
      { href: '/all-articles/foundation-soil-behavior-in-the-phoenix-metropolitan-area', title: 'Phoenix Soil Behavior' },
      { href: '/all-articles/southern-arizona-soil-conditions-and-structural-behavior', title: 'Southern Arizona Soils' },
    ],
  },
  {
    id: 'systems',
    label: 'Foundation systems',
    links: [
      { href: '/all-articles/slab-on-grade-foundations-what-they-are-and-what-they-dont-automatically-tell-you', title: 'Slab-on-Grade Foundations' },
      { href: '/all-articles/crawlspaces-what-they-are-and-why-they-get-blamed-for-so-many-problems', title: 'Crawlspaces' },
      { href: '/all-articles/underpinning-what-it-is-and-why-hearing-the-term-is-not-a-diagnosis', title: 'Underpinning' },
      { href: '/all-articles/helicalpiers', title: 'Helical Piers (article)' },
      { href: '/all-articles/why-torque-alone-doesnt-guarantee-capacity', title: 'Torque and Capacity' },
    ],
  },
  {
    id: 'signs',
    label: 'Signs and inspection',
    links: [
      { href: '/all-articles/common-signs-a-foundation-inspection-may-be-worth-considering', title: 'When an Inspection May Be Worth Considering' },
    ],
  },
];

const nav = groups.map((g) => ({ id: g.id, label: g.label }));
---

<BaseLayout
  title="Educational Articles"
  description="In-depth articles on foundation behavior, soils, structural movement, and construction materials."
  hub={true}
  quote="Understanding comes from seeing how many small pieces fit together."
>
  <HubPageShell
    title="Educational Articles"
    subhead="Foundation behavior, soils, and structural movement — written to be read"
    glance={[
      { label: 'Purpose', value: 'Understand before you decide' },
      { label: 'Tone', value: 'No urgency' },
      { label: 'Format', value: 'Papers, not posts' },
      { label: 'Also', value: 'Industry articles live next door' },
    ]}
    nav={nav}
    topicsStyle="list"
  >
    {groups.map((group) => (
      <div class="accordion-section" id={group.id}>
        <div class="accordion-header">
          <span class="accordion-title">{group.label}</span>
          <span class="accordion-icon">▸</span>
        </div>
        <div class="accordion-content">
          <div class="accordion-content-inner">
            <div class="related-links">
              {group.links.map((link) => (
                <a href={link.href}>{cleanTitle(link.title)} →</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
    <div class="related-links">
      <a href="/industry-articles">Industry articles →</a>
      <a href="/all-articles">All articles →</a>
      <a href="/start-here">Start Here →</a>
    </div>
  </HubPageShell>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubPageShell from '../components/hub/HubPageShell.astro';
import extracted from '../../content/extracted/foundation-repair-dictionary.html?raw';
import additions from '../data/dictionary-additions.html?raw';

function card(id: string) {
  const start = additions.indexOf(`<div class="term-card" id="${id}">`);
  if (start < 0) return '';
  const next = additions.indexOf('<div class="term-card"', start + 1);
  const end = next > 0 ? next : additions.indexOf('</section>', start);
  return additions.slice(start, end).trim();
}

function termName(html: string) {
  return html.match(/<div class="term-name">([^<]+)<\/div>/)?.[1] ?? '';
}

// Each addition is filed under the letter its term actually starts with —
// computed from the term's own name, not guessed from a marker position.
const additionIds = [
  'auger-cast-pile', 'bond-strength', 'caliche', 'compaction-grouting',
  'drilled-pier', 'driven-pile', 'fill', 'floor-elevation-survey',
  'foam-jacking', 'geotechnical-investigation', 'helical-pier-capacity',
  'limited-access', 'load-testing', 'moisture-content', 'native-soil',
  'polyurethane-injection', 'torque-correlation',
];

let body = extracted
  .replace(/<div class="floating-nav"[\s\S]*?<\/div>/, '')
  .replace(/<div class="page-header"[\s\S]*?<\/div>/, '');

function insertAlphabetically(sectionBody: string, cardHtml: string, name: string) {
  const cardStarts = [...sectionBody.matchAll(/<div class="term-card" id="[a-z0-9-]+">/g)].map((m) => m.index!);
  let insertAt = sectionBody.length;
  for (const start of cardStarts) {
    const existingName = sectionBody.slice(start).match(/<div class="term-name">([^<]+)<\/div>/)?.[1] ?? '';
    if (existingName.toLowerCase() > name.toLowerCase()) {
      insertAt = start;
      break;
    }
  }
  return sectionBody.slice(0, insertAt) + cardHtml + sectionBody.slice(insertAt);
}

for (const id of additionIds) {
  const html = card(id);
  if (!html || body.includes(`id="${id}"`)) continue;
  const name = termName(html);
  const letter = name.charAt(0).toUpperCase();
  const sectionHeader = `<section class="letter-section" id="${letter}"><h2 class="letter-heading">${letter}</h2>`;
  const sectionStart = body.indexOf(sectionHeader);
  if (sectionStart < 0) continue;
  const contentStart = sectionStart + sectionHeader.length;
  const sectionEnd = body.indexOf('</section>', contentStart);
  const newContent = insertAlphabetically(body.slice(contentStart, sectionEnd), html, name);
  body = body.slice(0, contentStart) + newContent + body.slice(sectionEnd);
}

const knownIds = new Set([...body.matchAll(/id="([a-z0-9-]+)"/g)].map((m) => m[1]));

body = body.replace(
  /<span class="related-term" data-term="([^"]+)">([^<]+)<\/span>/g,
  (_m, id, label) =>
    knownIds.has(id)
      ? `<a class="related-term" href="#${id}">${label}</a>`
      : `<span class="related-term">${label}</span>`
);
---

<BaseLayout
  title="Foundation Repair Dictionary"
  description="Plain-language definitions of foundation repair terms homeowners commonly hear."
  hub={true}
>
  <HubPageShell
    title="Foundation Repair Dictionary"
    subhead="Plain-language definitions for homeowners — and anyone trying to understand what is happening beneath a foundation"
    nav={[]}
    topicsStyle="none"
  >
    <div class="dictionary">
      <p class="dictionary-lede">
        Plain-language definitions for homeowners — and anyone trying to understand what’s happening beneath their foundation.
      </p>
      <Fragment set:html={body} />
    </div>
  </HubPageShell>
</BaseLayout>

<style is:global>
  .dictionary { max-width: 720px; }
  .dictionary-lede {
    border-left: 2px solid #c8c8c8;
    padding: 4px 0 28px 18px;
    margin: 8px 0 0;
    color: #5a5a5a;
    font-size: 18px;
    line-height: 1.65;
    border-bottom: 1px solid #e4e4e4;
  }
  .dictionary .letter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    margin: 28px 0 0;
    padding: 16px 0;
    border-bottom: 1px solid #e4e4e4;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 15px;
    letter-spacing: 2px;
  }
  .dictionary .letter-nav a {
    color: #1a1a1a;
    font-weight: 500;
    text-decoration: none;
  }
  .dictionary .letter-nav a:hover,
  .dictionary .letter-nav a:focus {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .dictionary .empty-letter { color: #c8c8c8; font-weight: 400; }
  .dictionary .letter-section { margin: 0 0 32px; }
  .dictionary .letter-heading {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 400;
    color: #8a8a8a;
    margin: 28px 0 0;
    padding-bottom: 12px;
    border-bottom: 1px solid #e4e4e4;
  }
  .dictionary .term-card {
    background: #fff;
    border: 1px solid #d8d8d8;
    padding: 28px 32px 22px;
    margin: 18px 0 0;
  }
  .dictionary .term-name {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 600;
    margin: 0 0 12px;
    color: #1a1a1a;
  }
  .dictionary .term-definition p {
    margin: 0 0 14px;
    font-size: 17px;
    line-height: 1.7;
    color: #2e2e2e;
  }
  .dictionary .term-definition p:last-child { margin-bottom: 0; }
  .dictionary .related-terms {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid #ececec;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: baseline;
  }
  .dictionary .related-label {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #8a8a8a;
  }
  .dictionary a.related-term {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 15px;
  }
  .dictionary span.related-term {
    color: #5a5a5a;
    font-size: 15px;
  }
</style>

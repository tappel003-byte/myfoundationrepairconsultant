---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubPageShell from '../components/hub/HubPageShell.astro';
import extracted from '../../content/extracted/foundation-repair-dictionary.html?raw';
import additions from '../data/dictionary-additions.html?raw';

function card(id: string) {
  const start = additions.indexOf(`<div class="term-card" id="${id}">`);
  if (start < 0) return '';
  const next = additions.indexOf('<div class="term-card"', start + 1);
  const end = next > 0 ? next : additions.indexOf('</section>', start);
  return additions.slice(start, end).trim();
}

const inserts: [string, string][] = [
  ['</section><!-- A -->', card('auger-cast-pile')],
  ['</section><!-- B -->', card('bond-strength')],
  ['</section><!-- C -->', card('caliche')],
  ['</section><!-- C -->', card('compaction-grouting')],
  ['</section><!-- D -->', card('drilled-pier')],
  ['</section><!-- D -->', card('driven-pile')],
  ['</section><!-- F -->', card('fill')],
  ['</section><!-- F -->', card('floor-elevation-survey')],
  ['</section><!-- F -->', card('foam-jacking')],
  ['</section><!-- H -->', card('geotechnical-investigation')],
  ['</section><!-- I -->', card('helical-pier-capacity')],
  ['</section><!-- L -->', card('limited-access')],
  ['</section><!-- M -->', card('load-testing')],
  ['</section><!-- M -->', card('moisture-content')],
  ['</section><!-- N -->', card('native-soil')],
  ['</section><!-- P -->', card('polyurethane-injection')],
  ['</section><!-- U -->', card('torque-correlation')],
];

let body = extracted
  .replace(/<div class="floating-nav"[\s\S]*?<\/div>/, '')
  .replace(/<div class="page-header"[\s\S]*?<\/div>/, '');

for (const [marker, html] of inserts) {
  const id = html.match(/id="([^"]+)"/)?.[1];
  if (html && body.includes(marker) && id && !body.includes(`id="${id}"`)) {
    body = body.replace(marker, `${html}\n${marker}`);
  }
}

const knownIds = new Set([...body.matchAll(/id="([a-z0-9-]+)"/g)].map((m) => m[1]));

body = body.replace(
  /<span class="related-term" data-term="([^"]+)">([^<]+)<\/span>/g,
  (_m, id, label) =>
    knownIds.has(id)
      ? `<a class="related-term" href="#${id}">${label}</a>`
      : `<span class="related-term">${label}</span>`
);
---

<BaseLayout
  title="Foundation Repair Dictionary"
  description="Plain-language definitions of foundation repair terms homeowners commonly hear."
  hub={true}
>
  <HubPageShell
    title="Foundation Repair Dictionary"
    subhead="Plain-language definitions for homeowners — and anyone trying to understand what is happening beneath a foundation"
    nav={[]}
    topicsStyle="none"
  >
    <div class="dictionary">
      <p class="dictionary-lede">
        Plain-language definitions for homeowners — and anyone trying to understand what’s happening beneath their foundation.
      </p>
      <Fragment set:html={body} />
    </div>
  </HubPageShell>
</BaseLayout>

<style is:global>
  .dictionary { max-width: 720px; }
  .dictionary-lede {
    border-left: 2px solid #c8c8c8;
    padding: 4px 0 28px 18px;
    margin: 8px 0 0;
    color: #5a5a5a;
    font-size: 18px;
    line-height: 1.65;
    border-bottom: 1px solid #e4e4e4;
  }
  .dictionary .letter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    margin: 28px 0 0;
    padding: 16px 0;
    border-bottom: 1px solid #e4e4e4;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 15px;
    letter-spacing: 2px;
  }
  .dictionary .letter-nav a {
    color: #1a1a1a;
    font-weight: 500;
    text-decoration: none;
  }
  .dictionary .letter-nav a:hover,
  .dictionary .letter-nav a:focus {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .dictionary .empty-letter { color: #c8c8c8; font-weight: 400; }
  .dictionary .letter-section { margin: 0 0 32px; }
  .dictionary .letter-heading {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 400;
    color: #8a8a8a;
    margin: 28px 0 0;
    padding-bottom: 12px;
    border-bottom: 1px solid #e4e4e4;
  }
  .dictionary .term-card {
    background: #fff;
    border: 1px solid #d8d8d8;
    padding: 28px 32px 22px;
    margin: 18px 0 0;
  }
  .dictionary .term-name {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 600;
    margin: 0 0 12px;
    color: #1a1a1a;
  }
  .dictionary .term-definition p {
    margin: 0 0 14px;
    font-size: 17px;
    line-height: 1.7;
    color: #2e2e2e;
  }
  .dictionary .term-definition p:last-child { margin-bottom: 0; }
  .dictionary .related-terms {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid #ececec;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: baseline;
  }
  .dictionary .related-label {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #8a8a8a;
  }
  .dictionary a.related-term {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 15px;
  }
  .dictionary span.related-term {
    color: #5a5a5a;
    font-size: 15px;
  }
</style>

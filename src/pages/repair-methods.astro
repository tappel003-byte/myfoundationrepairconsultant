---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubPageShell from '../components/hub/HubPageShell.astro';

const nav = [
  { id: 'doors', label: 'Your situation' },
  { id: 'methods', label: 'The methods' },
  { id: 'start', label: 'Start here' },
  { id: 'core', label: 'Core questions' },
  { id: 'orient', label: 'Where to read next' },
  { id: 'more', label: 'More questions' },
  { id: 'before', label: 'Questions before choosing' },
];

const pageDescription =
  'Repair methods explained as jobs, not products: helical piers, micropiles, push piers, compaction grouting, foam jacking, and other deep foundations. A method name is not a diagnosis. The right tool matches the load path, the movement, the soil, and the water.';

const schema = {
  '@context': 'https://schema.org',
  '@type': ['Article', 'FAQPage'],
  headline: 'Repair Methods',
  description: pageDescription,
  url: 'https://www.myfoundationrepairconsultant.com/repair-methods',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': 'https://www.myfoundationrepairconsultant.com/repair-methods',
  },
  author: { '@type': 'Organization', name: 'My Foundation Repair Consultant' },
  publisher: {
    '@type': 'Organization',
    name: 'My Foundation Repair Consultant',
    logo: {
      '@type': 'ImageObject',
      url: 'https://images.squarespace-cdn.com/content/v1/6983db0242b9b6302c661059/fa18c5f7-2e51-4ae1-81d8-0517c590d714/MFRC+Logo.jpg',
    },
  },
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does my foundation need deeper support?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'That describes a job, not yet a method. Ask what load must move, where it must go, and why deeper support is needed. Helical piers, push piers, and micropiles may apply when the question is a structural underpinning load path.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is the soil under my house the problem?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Soil can mean moisture-sensitive ground, loose fill, loss of support, erosion, or something else. Ask what condition was identified and how. Compaction grouting and, in some cases, foam jacking or other ground-improvement systems may apply.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there a void under my slab?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A void can matter a great deal — or be only one part of the story. Ask what created it and whether the source is still active. Foam jacking and compaction grouting are the usual places to start reading.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can this be lifted?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Lift and stabilization are different jobs. Ask whether lift is necessary, how much is intended, what could limit it, and what will be monitored. Foam jacking is often discussed for slabs. Helical or push piers may be discussed when a footing itself is being lifted.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does "bedrock" automatically mean the repair is sound?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. "Bedrock" is not a complete design explanation. What material was encountered, at what depth, whether it is competent for the intended load, how the system engages it, and how the existing building connects to the proposed support all matter.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does a deeper repair automatically mean a better repair?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. A deeper system may be appropriate where shallow support is inadequate, but depth alone does not solve a moisture problem, a drainage problem, a structural-connection problem, a void, or an incorrect diagnosis.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can compaction grouting and foam do the same thing?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Their scopes can overlap around voids, loose ground, slab support, or controlled lifting, but the materials and mechanisms differ. Compaction grouting uses stiff low-mobility grout to displace and densify ground; polyurethane injection uses expanding resin to fill voids and potentially lift or improve support.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why might a contractor propose one method but not another?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The reason may be legitimate — access, equipment size, building weight, footing condition, vibration limits, depth of weak soil, obstructions, soil type, water conditions, desired lift, or cost. The owner should still ask what alternatives were considered and why they were ruled out.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can methods be combined?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. A project may combine drainage correction, underpinning, void filling, soil improvement, monitoring, or slab repair — but a combination should be tied to distinct identified problems, not assumed to be more thorough by default.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the proposed load path?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'How load moves from the existing footing, wall, column, or slab into the proposed repair, and then into the ground.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the existing foundation actually capable of carrying?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A high-capacity pier does not automatically make a weak, narrow, cracked, poorly reinforced, or eccentric footing suitable for concentrated bracket loads.',
      },
    },
  ],
};
---

---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubPageShell from '../components/hub/HubPageShell.astro';
import { INDUSTRY_GROUPS as groups } from '../lib/articleGroups';

const nav = groups.map((g) => ({ id: g.id, label: g.label }));
const countLabel = (n) => (n === 1 ? '(1 article)' : `(${n} articles)`);
---

<BaseLayout
  title="Industry Articles"
  description="How the foundation repair industry works—business models, sales practices, and what building owners should understand when evaluating contractors and recommendations."
  hub={true}
>
  <HubPageShell
    title="Industry Articles"
    subhead="Industry Articles"
    bannerBlurb="Short observations that provide context around common language, marketing, and processes within the foundation repair industry."
    nav={nav}
    topicsStyle="none"
  >
    <div class="cabinet">
      {groups.map((group) => (
        <div class="cabinet-row accordion-section" id={group.id}>
          <div class="accordion-header">
            <span class="accordion-title">{group.label} <em>{countLabel(group.links.length)}</em></span>
            <span class="accordion-icon">▸</span>
          </div>
          <div class="accordion-content">
            <div class="accordion-content-inner">
              <div class="article-index-links">
                {group.links.map((link) => (
                  <a href={link.href}>{link.title}</a>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </HubPageShell>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubPageShell from '../components/hub/HubPageShell.astro';
import { cleanTitle } from '../lib/pages';

const groups = [
  {
    id: 'incentives',
    label: 'Incentives and evaluations',
    links: [
      { href: '/all-articles/the-free-evaluation-and-the-culture-it-creates', title: 'The Hidden Cost of Free Foundation Evaluations' },
      { href: '/all-articles/if-you-show-me-the-incentive-ill-show-you-the-outcome', title: 'If You Show Me the Incentive' },
      { href: '/all-articles/what-is-a-sales-metric-and-why-it-doesnt-translate-to-foundation-repair', title: 'How Sales Metrics Influence Decisions' },
    ],
  },
  {
    id: 'urgency',
    label: 'Urgency and signing',
    links: [
      { href: '/all-articles/psychology-of-sign-today-discounts', title: 'Sign-Today Discounts' },
      { href: '/all-articles/symptoms-are-easy-to-see-causes-are-not', title: 'Symptoms Are Easy to See' },
      { href: '/know-before-you-sign', title: 'Know Before You Sign' },
    ],
  },
  {
    id: 'scope',
    label: 'Scope and estimates',
    links: [
      { href: '/all-articles/how-to-compare-foundation-repair-estimates', title: 'How to Compare Estimates' },
      { href: '/all-articles/why-a-detailed-scope-of-work-matters-in-foundation-repair', title: 'Why a Detailed Scope of Work Matters' },
      { href: '/all-articles/managing-change-orders-in-foundation-repair', title: 'Managing Change Orders' },
    ],
  },
];

const nav = groups.map((g) => ({ id: g.id, label: g.label }));
---

<BaseLayout
  title="Industry Articles"
  description="How the foundation repair industry works — business models, sales practices, and what to understand when evaluating a recommendation."
  hub={true}
  quote="Clear information leads to better decisions."
>
  <HubPageShell
    title="Industry Articles"
    subhead="How the business side of foundation repair shapes what you hear"
    glance={[
      { label: 'Purpose', value: 'See the incentive structure' },
      { label: 'Tone', value: 'Context, not outrage' },
      { label: 'Format', value: 'Short papers' },
      { label: 'Also', value: 'Educational articles next door' },
    ]}
    nav={nav}
    topicsStyle="list"
  >
    {groups.map((group) => (
      <div class="accordion-section" id={group.id}>
        <div class="accordion-header">
          <span class="accordion-title">{group.label}</span>
          <span class="accordion-icon">▸</span>
        </div>
        <div class="accordion-content">
          <div class="accordion-content-inner">
            <div class="related-links">
              {group.links.map((link) => (
                <a href={link.href}>{cleanTitle(link.title)} →</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
    <div class="related-links">
      <a href="/how-the-industry-has-changed">How the industry has changed →</a>
      <a href="/educational-articles">Educational articles →</a>
      <a href="/all-articles">All articles →</a>
    </div>
  </HubPageShell>
</BaseLayout>

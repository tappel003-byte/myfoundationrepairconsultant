---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { linkDictionaryLists } from '../../lib/dictionaryLink';
import rawHtml from '../../../content/extracted/structural-damage-vs-cosmetic-damage.html?raw';
import dictHtml from '../../../content/extracted/foundation-repair-dictionary.html?raw';

const dictIds = new Set([...dictHtml.matchAll(/id="([a-z0-9-]+)"/g)].map((m) => m[1]));
const html = linkDictionaryLists(rawHtml, dictIds);
---
<BaseLayout title="Structural Damage vs. Cosmetic Damage" description="What those labels describe, and what they do not decide." hub={false}>
  <article class="paper">
    <div class="floating-nav" id="articleTopNav">
      <a href="#" id="articleTopLink" class="top-link"><span>↑</span> Top</a>
    </div>
    <header class="paper-head">
      <h1>Structural Damage vs. Cosmetic Damage</h1>
    </header>
    <div class="paper-body" set:html={html} />
  </article>
</BaseLayout>

<script>
  const floatingNav = document.getElementById('articleTopNav');
  const head = document.querySelector('.paper-head');
  const topLink = document.getElementById('articleTopLink');

  if (floatingNav && head) {
    window.addEventListener('scroll', () => {
      floatingNav.classList.toggle('visible', window.scrollY > head.offsetHeight);
    });
    topLink?.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

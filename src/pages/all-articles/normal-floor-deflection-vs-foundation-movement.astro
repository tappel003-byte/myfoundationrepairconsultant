---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { linkDictionaryLists } from '../../lib/dictionaryLink';
import rawHtml from '../../../content/extracted/normal-floor-deflection-vs-foundation-movement.html?raw';
import dictHtml from '../../../content/extracted/foundation-repair-dictionary.html?raw';

const dictIds = new Set([...dictHtml.matchAll(/id="([a-z0-9-]+)"/g)].map((m) => m[1]));
const html = linkDictionaryLists(rawHtml, dictIds);
---
<BaseLayout title="Normal Floor Deflection vs. Foundation Movement" description="Why an uneven floor is often framing or construction tolerance — and when slope is reporting a change in support." hub={false}>
  <article class="paper">
    <header class="paper-head">
      <h1>Normal Floor Deflection vs. Foundation Movement</h1>
    </header>
    <div class="paper-body" set:html={html} />
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { linkFirstMentions } from '../../lib/dictionaryLink';
import raw from '../../../content/extracted/the-word-failure.html?raw';

const html = linkFirstMentions(raw);
---

<BaseLayout
  title={'The Word “Failure”'}
  description={'Why “failure” is the industry’s most effective word, what it actually requires in engineering terms, and how to hear it without losing time.'}
>
  <article class="paper">
    <div class="floating-nav" id="articleTopNav">
      <a href="#" id="articleTopLink" class="top-link"><span>↑</span> Top</a>
    </div>
    <header class="paper-head">
      <h1>The Word “Failure”</h1>
    </header>
    <div class="paper-body" set:html={html} />
    <nav class="paper-pager" aria-label="More papers">
      <a class="pager-prev" href="/how-the-industry-has-changed">
        <span>←</span>
        How the Industry Has Changed
      </a>
      <a class="pager-next" href="/all-articles/foundation-failure-patterns-and-prevention">
        Foundation Failure Patterns and Prevention
        <span>→</span>
      </a>
    </nav>
  </article>
</BaseLayout>

<script>
  const floatingNav = document.getElementById('articleTopNav');
  const head = document.querySelector('.paper-head');
  const topLink = document.getElementById('articleTopLink');

  if (floatingNav && head) {
    window.addEventListener('scroll', () => {
      floatingNav.classList.toggle('visible', window.scrollY > head.offsetHeight);
    });
    topLink?.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style is:global>
  .paper {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px 48px 80px;
  }
  .paper-head h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    margin: 0 0 36px;
  }
  .paper-body {
    font-size: 18px;
    line-height: 1.75;
  }
  .paper-body h2 {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 600;
    margin: 36px 0 14px;
    line-height: 1.25;
  }
  .paper-body h3 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 600;
    margin: 28px 0 12px;
    line-height: 1.3;
  }
  .paper-body p { margin: 0 0 16px; }
  .paper-body ul,
  .paper-body ol {
    margin: 12px 0 20px;
    padding-left: 1.4em;
  }
  .paper-body li { margin: 0 0 8px; }
  .paper-body a {
    color: #2d9499;
  }
  .paper-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid #e4e4e4;
  }
  .paper-pager a {
    color: #2d9499;
    text-decoration: none;
    font-size: 17px;
    line-height: 1.35;
  }
  .paper-pager a:hover {
    color: #1a1a1a;
  }
  .pager-next { text-align: right; }
</style>

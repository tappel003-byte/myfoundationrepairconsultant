---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { linkDictionaryLists } from '../../lib/dictionaryLink';
import rawHtml from '../../../content/extracted/how-to-document-and-monitor-floor-slope.html?raw';
import dictHtml from '../../../content/extracted/foundation-repair-dictionary.html?raw';

const dictIds = new Set([...dictHtml.matchAll(/id="([a-z0-9-]+)"/g)].map((m) => m[1]));
const html = linkDictionaryLists(rawHtml, dictIds);
---
<BaseLayout title="How to Document and Monitor Floor Slope Over Time" description="A homeowner method for recording whether floor slope is changing — without treating a marble as a survey." hub={false}>
  <article class="paper">
    <header class="paper-head">
      <h1>How to Document and Monitor Floor Slope Over Time</h1>
    </header>
    <div class="paper-body" set:html={html} />
  </article>
</BaseLayout>

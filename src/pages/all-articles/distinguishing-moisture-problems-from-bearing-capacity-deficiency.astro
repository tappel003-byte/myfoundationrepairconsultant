---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { linkDictionaryLists } from '../../lib/dictionaryLink';
import rawHtml from '../../../content/extracted/distinguishing-moisture-problems-from-bearing-capacity-deficiency.html?raw';
import dictHtml from '../../../content/extracted/foundation-repair-dictionary.html?raw';

const dictIds = new Set([...dictHtml.matchAll(/id="([a-z0-9-]+)"/g)].map((m) => m[1]));
const html = linkDictionaryLists(rawHtml, dictIds);
---
<BaseLayout title="Moisture Problems vs. Bearing Capacity" description="Why water and weak soil can leave the same marks and still need different responses." hub={false}>
  <article class="paper">
    <header class="paper-head">
      <h1>Distinguishing Moisture Problems from Bearing Capacity Deficiency</h1>
    </header>
    <div class="paper-body" set:html={html} />
  </article>
</BaseLayout>

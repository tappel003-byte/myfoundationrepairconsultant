---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubPageShell from '../components/hub/HubPageShell.astro';
import TermGlossary from '../components/TermGlossary.astro';
import { articleSchema, stripHtml } from '../lib/schema';

const terms = [
  {
    term: 'Settlement',
    def: 'Downward movement as soil compresses under load. Common. Not automatically a problem.',
  },
  {
    term: 'Expansive soil',
    def: 'Clay that swells when wet and shrinks when dry.',
  },
  {
    term: 'Collapsible soil',
    def: 'Soil that loses volume the first time it gets wet under load.',
  },
  {
    term: 'Foundation cracks',
    def: 'A crack in concrete or masonry. A record of stress, not a diagnosis.',
  },
  {
    term: 'Structural cracks',
    def: 'A crack that follows a load path or keeps growing. Still not a product to buy.',
  },
  {
    term: 'Foundation types',
    def: 'How the house is supported: slab, crawlspace, basement, and the rest.',
  },
  {
    term: 'Pier',
    def: 'A vertical foundation element that transfers structural loads down to the soil or rock below.',
  },
  {
    term: 'Drainage',
    def: 'How surface and subsurface water moves around and away from a home.',
  },
  {
    term: 'Footing',
    def: 'The portion of a foundation that spreads the weight of the structure into the soil below.',
  },
];

const faqs = [
  {
    id: 'settlement-normal',
    q: 'Is foundation settlement normal?',
    body: `<p>Yes. All buildings settle to some degree. Settlement is downward movement as soil compresses under load and adjusts to moisture changes.</p>
    <p><strong>Typically no concern when:</strong> uniform across the foundation, minimal (fractions of an inch), and stable (movement stopped).</p>
    <p><strong>Becomes a concern when:</strong> differential (uneven), ongoing, or significant relative to tolerances.</p>
    <div class="related-links"><a href="/foundation-repair-dictionary#settlement">Settlement →</a><a href="/all-articles/differential-settlement-why-uneven-movement-matters-more-than-movement-itself">Differential settlement →</a></div>`,
  },
  {
    id: 'causes',
    q: 'What causes foundation settlement?',
    body: `<p>Soil compresses, shifts, or loses volume beneath the foundation — often from combined factors:</p>
    <ul><li><strong>Soil compression</strong> under building weight (worse in uncompacted fill)</li><li><strong>Moisture changes</strong> — drought shrinkage, poor drainage, leaks, tree roots, seasonal cycles</li><li><strong>Soil erosion</strong> washing fine particles from beneath the foundation</li></ul>
    <p>Understanding <em>why</em> settlement occurred determines whether intervention is appropriate. Repair recommended without investigating cause is incomplete evaluation.</p>`,
  },
  {
    id: 'differential',
    q: 'What is differential settlement?',
    body: `<p>When one part of a foundation moves more than another. The issue is uneven movement — not total movement.</p>
    <p>Even small differences create stress in rigid structures, appearing as cracks, sloping floors, trim separation, or sticking doors.</p>
    <p><strong>Uniform settlement</strong> rarely creates visible symptoms. <strong>Differential settlement</strong> creates stress even when total movement seems small.</p>
    <p>The key question: is it historic and stable, or active and progressive? That requires investigation — not assumptions from cracks alone.</p>`,
  },
  {
    id: 'problem-vs-settling',
    q: 'Foundation problem vs. normal settling?',
    body: `<p>Not always obvious visually. Many symptoms are normal material behavior — not foundation movement.</p>
    <p><strong>Normal settling:</strong> early after construction, relatively uniform, minor cosmetic changes, stabilizes over time.</p>
    <p><strong>Foundation problems:</strong> uneven movement, worsening symptoms, correlation with moisture events, structural distress.</p>
    <p><strong>Key distinction:</strong> material cracks come from how building materials behave; foundation cracks come from uneven support conditions.</p>
    <div class="related-links"><a href="/all-articles/foundation-problem-vs-normal-settling-how-to-evaluate-what-youre-seeing">Full article →</a><a href="/material-behavior">Material behavior →</a></div>`,
  },
  {
    id: 'signs',
    q: 'What are the signs of foundation settlement?',
    body: `<p>Observable changes: cracks in walls/floors/ceilings, sticking doors/windows, uneven floors, gaps at trim.</p>
    <p>Signs indicate movement occurred — they do <em>not</em> indicate cause, whether movement is ongoing, severity, or whether repair is needed.</p>
    <div class="related-links"><a href="/common-signs">Common signs hub →</a><a href="/material-behavior">Material behavior →</a></div>`,
  },
  {
    id: 'acceptable',
    q: 'How much foundation movement is acceptable?',
    body: `<p>No single answer — depends on structure type, use, and context. Industry guidelines (often ½–¾ inch differential over 20–30 feet) are reference points, not pass/fail thresholds.</p>
    <p><strong>Rate</strong> matters more than magnitude. <strong>Pattern</strong> matters more than total. A stable 1-inch historic settlement differs from continuous ⅛-inch-per-year movement.</p>`,
  },
  {
    id: 'serious',
    q: 'When is foundation settlement serious?',
    body: `<p>"Serious" may mean safety risk (rare in residential), property impact, progressive worsening, or functional impact.</p>
    <p>Warrants evaluation when movement is measurable and ongoing, localized/differential, tied to moisture events, or structural elements show distress.</p>
    <p>May <em>not</em> require intervention when movement is historic, stable, minor, and the building functions normally.</p>
    <p>When someone insists urgent repair without investigation or monitoring data — question whether that judgment is supported.</p>`,
  },
  {
    id: 'one-side',
    q: 'What causes one side or corner to sink?',
    body: `<p>Localized settlement from conditions affecting one area differently: soil variations (fill vs. native, weak layers), moisture concentration (grading, downspouts, leaks, trees), or concentrated loads (chimneys, additions).</p>`,
  },
  {
    id: 'structural-vs-cosmetic',
    q: 'Structural damage or cosmetic?',
    body: `<p><strong>Structural:</strong> compromises load-bearing capacity or connections. <strong>Cosmetic:</strong> appearance only — drywall cracks, trim gaps, minor slab cracks.</p>
    <p>Many symptoms fall between. Visual appearance alone often cannot determine which. Professional evaluation examines load paths, distress magnitude, and progression.</p>
    <div class="related-links"><a href="/all-articles/structural-damage-vs-cosmetic-damage">Structural vs. cosmetic →</a></div>`,
  },
  {
    id: 'need-repair',
    q: 'Do I need foundation repair?',
    body: `<p>Requires professional investigation — not assumptions from visible symptoms alone.</p>
    <p>Repair addresses progressive or differential settlement creating unacceptable stress. Many situations do <em>not</em> require repair: historic stable settlement, minor uniform movement, conditions suited to monitoring or drainage correction.</p>
    <p>Find a qualified professional who investigates before recommending — not someone whose compensation depends on closing a repair contract.</p>`,
  },
];

const nav = faqs.map((f) => ({ id: f.id, label: f.q.replace('?', '') }));
const schema = articleSchema({
  headline: 'Start Here',
  description: 'Independent foundation repair education. Ten questions building owners ask when they notice cracks, sticking doors, or movement.',
  url: 'https://www.myfoundationrepairconsultant.com/start-here',
  faqs: faqs.map((f) => ({ name: f.q, text: stripHtml(f.body) })),
});
---

<BaseLayout
  title="Start Here"
  description="Independent foundation repair education. Ten questions building owners ask when they notice cracks, sticking doors, or movement."
  hub={true}
  quote="The question is not whether your building has cracks—most do. The question is whether those cracks tell a story of past movement that has stabilized, or ongoing movement that requires attention."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <HubPageShell
    title="Start Here"
    subhead="Ten questions building owners ask when something doesn't feel right"
    description="Most building owners don't start by looking for foundation repair. They start by noticing a crack, a door that sticks, or something that just doesn't feel right."
    glance={[
      { label: 'Purpose', value: 'Education before action' },
      { label: 'Tone', value: 'No urgency, no sales' },
      { label: 'Format', value: '10 essential questions' },
      { label: 'Depth', value: 'Overview → linked articles' },
    ]}
    nav={nav}
    topicsStyle="list"
  >
    <div slot="before-topics">
      <TermGlossary terms={terms} />
    </div>

    <div class="faq-list" data-faq-group>
      {faqs.map((faq) => (
        <div class="accordion-section" id={faq.id}>
          <div class="accordion-header">
            <span class="accordion-title">{faq.q}</span>
            <span class="accordion-icon">▸</span>
          </div>
          <div class="accordion-content">
            <div class="accordion-content-inner content-block" set:html={faq.body} />
          </div>
        </div>
      ))}
    </div>

    <h2 class="section-heading">Moving forward</h2>
    <div class="condition-grid">
      <div class="condition-card">
        <h4>Understand what you're seeing</h4>
        <div class="related-links">
          <a href="/material-behavior">Material behavior</a>
          <a href="/common-signs">Common signs</a>
          <a href="/foundation-repair-dictionary">Dictionary</a>
        </div>
      </div>
      <div class="condition-card">
        <h4>Regional foundation behavior</h4>
        <div class="related-links">
          <a href="/foundation-behavior-in-new-mexico">New Mexico</a>
          <a href="/foundation-behavior-in-arizona">Arizona</a>
          <a href="/new-mexico-soil-conditions">NM soils</a>
        </div>
      </div>
      <div class="condition-card">
        <h4>Industry context</h4>
        <div class="related-links">
          <a href="/how-the-industry-has-changed">How the industry changed</a>
          <a href="/industry-articles">Industry articles</a>
          <a href="/know-before-you-sign">Know before you sign</a>
        </div>
      </div>
      <div class="condition-card">
        <h4>Explore further</h4>
        <div class="related-links">
          <a href="/investigate-further">Investigate further</a>
          <a href="/educational-articles">Educational articles</a>
          <a href="/all-articles">All articles</a>
        </div>
      </div>
    </div>
  </HubPageShell>
</BaseLayout>

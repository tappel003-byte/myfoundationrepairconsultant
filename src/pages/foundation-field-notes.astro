---
import BaseLayout from '../layouts/BaseLayout.astro';

const logoSrc =
  'https://images.squarespace-cdn.com/content/v1/6983db0242b9b6302c661059/fa18c5f7-2e51-4ae1-81d8-0517c590d714/MFRC+Logo.jpg?format=500w';

const heardCards = [
  {
    id: 'piers',
    heard: 'They said I need piers.',
    might: 'Trying to move part of the load to deeper, more stable ground.',
    prove: 'What caused the movement, whether it is still happening, or that a deep load path is actually the fix.',
    ask: 'What problem are the piers meant to solve, and what tells you that?',
    urgent: false,
  },
  {
    id: 'bedrock',
    heard: 'They said we have to get to bedrock.',
    might: 'Bedrock really can be a strong bearing layer — reaching it is sometimes exactly right.',
    prove: 'How deep it is, whether it is actually competent, or how the system connects to it.',
    ask: 'What material did you find, at what depth, and how does the design use it?',
    urgent: false,
  },
  {
    id: 'void',
    heard: 'They said there is a void under the slab.',
    might: 'Soil can wash out or settle, leaving a real gap.',
    prove: 'That the foundation itself needs underpinning — a slab and a footing carry different loads.',
    ask: 'Is this slab part of the building structural support, or just a floor that needs to sit right again?',
    urgent: false,
  },
  {
    id: 'lift',
    heard: 'They said they can lift it.',
    might: 'Some methods genuinely restore lost elevation, not just stop movement.',
    prove: 'Lift and stabilization are different goals — or how much lift, or what it does to plumbing and finishes.',
    ask: 'Is the goal to stop it, restore elevation, or both — and what happens to the rest of the house if it moves?',
    urgent: false,
  },
  {
    id: 'best',
    heard: 'They said this is the best system.',
    might: 'A specific method really can be the strongest fit for a specific site.',
    prove: '"Best" without a stated reason does not say why, for your house, specifically.',
    ask: 'Best for what condition — and compared to what?',
    urgent: false,
  },
  {
    id: 'now',
    heard: 'They said it needs to be fixed now.',
    might: 'Some things genuinely are urgent — active water, fast new movement, a real safety concern.',
    prove: 'Urgency in the pitch is not urgency in the ground. Historic, stable movement usually is not an emergency.',
    ask: 'What is actually changing right now — and what happens if I get a second opinion first?',
    urgent: true,
  },
];

const truthCards = [
  {
    id: 'same',
    claim: 'Helical piers and micropiles are the same thing.',
    answer: 'False',
    why: 'Rotated in with plates vs. drilled and grouted. Different mechanism entirely.',
  },
  {
    id: 'crack',
    claim: 'A crack always means the foundation is failing.',
    answer: 'False',
    why: 'Most cracks are ordinary material behavior, not structural distress.',
  },
  {
    id: 'foam',
    claim: 'Foam jacking is a type of pier.',
    answer: 'False',
    why: 'Foam fills voids and can lift a slab; it does not transfer load like a pier.',
  },
  {
    id: 'rock',
    claim: '"Bedrock" guarantees a stable repair.',
    answer: 'False',
    why: 'It still has to be identified, verified, and properly connected.',
  },
  {
    id: 'quiet',
    claim: 'A quieter, cheaper method can sometimes be the right one.',
    answer: 'True',
    why: 'The right method matches the problem, not the loudest pitch.',
  },
];

const situations = [
  {
    id: 'access',
    text: 'Limited access, low headroom',
    accept: ['helical', 'micropiles'],
    note: 'More than one method can genuinely fit here — that is not a trick, that is real.',
  },
  {
    id: 'loose',
    text: 'Loose or voided soil that can be densified',
    accept: ['grout'],
  },
  {
    id: 'slabvoid',
    text: 'A void under a slab',
    accept: ['foam'],
  },
  {
    id: 'heavy',
    text: 'Heavy structure, settlement that is localized and mapped',
    accept: ['push'],
  },
  {
    id: 'name',
    text: 'A name on the bid you do not recognize',
    accept: ['other'],
  },
];

const methods = [
  { id: 'helical', text: 'Helical Piers' },
  { id: 'micropiles', text: 'Micropiles' },
  { id: 'grout', text: 'Compaction Grouting' },
  { id: 'foam', text: 'Foam Jacking' },
  { id: 'push', text: 'Push Piers' },
  { id: 'other', text: 'Other Deep Foundations' },
];
---

<BaseLayout
  title="What Did You Just Hear? — Foundation Field Notes"
  description="A small deck of things people hear about foundation repair — what they might mean, what they do not prove, and a better question to ask. Not a diagnosis. Not a sales page."
>
  <div class="notes">
    <p class="notes-eyebrow">Just for the Fun of It</p>
    <h1>What Did You Just Hear?</h1>
    <p class="notes-lede">
      Three short decks. No score. No right house. Tap a card, read what came out of someone's mouth, and see the better question underneath.
    </p>

    <section class="game" id="heard">
      <h2>What they said</h2>
      <p class="game-note">Tap once for the sentence. Tap again for what it does and does not prove.</p>
      <div class="deck deck-3" data-shuffle>
        {heardCards.map((card) => (
          <div
            class:list={['flip', card.urgent && 'is-urgent']}
            role="button"
            tabindex="0"
            data-steps="3"
            aria-label={card.heard}
          >
            <div class="flip-inner">
              <div class="face face-down">
                <img src={logoSrc} alt="MFRC" width="180" height="114" />
              </div>
              <div class="face face-mid">
                <span class="kicker">Someone said</span>
                <span class="line">{card.heard}</span>
                <span class="hint">Tap again</span>
              </div>
              <div class="face face-up">
                <span class="bit"><strong>Might mean</strong>{card.might}</span>
                <span class="bit"><strong>Does not prove</strong>{card.prove}</span>
                <span class="bit ask"><strong>Ask instead</strong>{card.ask}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="game" id="truth">
      <h2>True or false</h2>
      <p class="game-note">Tap once for the claim. Tap again for the call.</p>
      <div class="deck deck-3" data-shuffle>
        {truthCards.map((card) => (
          <div class="flip" role="button" tabindex="0" data-steps="3" aria-label={card.claim}>
            <div class="flip-inner">
              <div class="face face-down">
                <img src={logoSrc} alt="MFRC" width="180" height="114" />
              </div>
              <div class="face face-mid">
                <span class="kicker">Claim</span>
                <span class="line">{card.claim}</span>
                <span class="hint">Tap again</span>
              </div>
              <div class="face face-up">
                <span class:list={['call', card.answer === 'True' && 'call-true']}>{card.answer}</span>
                <span class="why">{card.why}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="game" id="match">
      <h2>Match it</h2>
      <p class="game-note">
        Flip a situation. Flip a method. Some situations have more than one honest answer.
      </p>
      <p class="match-status" id="matchStatus" hidden></p>
      <div class="match-board">
        <div>
          <h3>Situation</h3>
          <div class="deck deck-2" data-shuffle>
            {situations.map((sit) => (
              <div
                class="flip match-card"
                role="button"
                tabindex="0"
                data-role="sit"
                data-id={sit.id}
                data-accept={sit.accept.join(',')}
                data-note={sit.note || ''}
                aria-label={sit.text}
              >
                <div class="flip-inner">
                  <div class="face face-down">
                    <img src={logoSrc} alt="MFRC" width="180" height="114" />
                  </div>
                  <div class="face face-up sit-face">
                    <span class="kicker">Situation</span>
                    <span class="line">{sit.text}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h3>Method</h3>
          <div class="deck deck-2" data-shuffle>
            {methods.map((method) => (
              <div
                class="flip match-card"
                role="button"
                tabindex="0"
                data-role="method"
                data-id={method.id}
                aria-label={method.text}
              >
                <div class="flip-inner">
                  <div class="face face-down">
                    <img src={logoSrc} alt="MFRC" width="180" height="114" />
                  </div>
                  <div class="face face-up method-face">
                    <span class="kicker">Method</span>
                    <span class="line">{method.text}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <p class="notes-exit">
      <a href="/repair-methods">Back to Repair Methods →</a>
    </p>
  </div>
</BaseLayout>

<style is:global>
  .notes {
    max-width: 1080px;
    margin: 0 auto;
    padding: 48px 32px 80px;
  }
  .notes-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #8a8a8a;
    margin: 0 0 12px;
  }
  .notes h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 600;
    line-height: 1.15;
    margin: 0 0 16px;
    color: #1a1a1a;
  }
  .notes-lede {
    max-width: 640px;
    font-size: 18px;
    line-height: 1.65;
    color: #5a5a5a;
    margin: 0 0 48px;
  }
  .notes .game { margin: 0 0 56px; }
  .notes .game h2 {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 600;
    margin: 0 0 8px;
  }
  .notes .game h3 {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 12px;
  }
  .notes .game-note {
    color: #5a5a5a;
    margin: 0 0 20px;
    font-size: 16px;
  }
  .notes .deck {
    display: grid;
    gap: 18px;
  }
  .notes .deck-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .notes .deck-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .notes .match-board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .notes .flip {
    position: relative;
    width: 100%;
    min-height: 260px;
    height: 260px;
    perspective: 1200px;
    cursor: pointer;
  }
  .notes .flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .notes .flip[data-step='1'] .flip-inner,
  .notes .flip[data-step='2'] .flip-inner { transform: rotateY(180deg); }
  .notes .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 10px;
    overflow: hidden;
  }
  .notes .face-down {
    background: #ececec;
    border: 1px solid #cfcfcf;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .notes .face-down img {
    width: 160px;
    max-width: 80%;
    height: auto;
    opacity: 0.7;
    display: block;
  }
  .notes .face-mid,
  .notes .face-up,
  .notes .sit-face,
  .notes .method-face {
    background: #fbf8f2;
    border: 1px solid #e2d9cc;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transform: rotateY(180deg);
  }
  .notes .flip[data-steps='3'] .face-up { opacity: 0; }
  .notes .flip[data-steps='3'][data-step='2'] .face-up { opacity: 1; }
  .notes .flip[data-steps='3'][data-step='2'] .face-mid { opacity: 0; }
  .notes .is-urgent .face-mid,
  .notes .is-urgent .face-up,
  .notes .is-urgent .face-down {
    border-left: 4px solid var(--chile);
  }
  .notes .kicker,
  .notes .hint {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a8a8a;
  }
  .notes .hint { margin-top: 14px; color: var(--teal); }
  .notes .line {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: #1a1a1a;
    margin-top: 8px;
  }
  .notes .bit {
    display: block;
    font-size: 14px;
    line-height: 1.45;
    color: #2e2e2e;
    margin-bottom: 10px;
  }
  .notes .bit strong {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    font-weight: 400;
    color: #8a8a8a;
    margin-bottom: 3px;
  }
  .notes .bit.ask strong { color: var(--teal); }
  .notes .call {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 10px;
  }
  .notes .call-true { color: var(--teal); }
  .notes .why {
    font-size: 15px;
    line-height: 1.5;
    color: #2e2e2e;
  }
  .notes .match-card.is-picked .face-up {
    outline: 2px solid var(--teal);
    outline-offset: -2px;
  }
  .notes .match-card.is-paired .face-up { background: #f3f1ea; }
  .notes .match-card.is-wrong { animation: notes-shake 0.35s ease; }
  .notes .match-status {
    background: #f3f1ea;
    border-left: 3px solid var(--teal);
    padding: 12px 16px;
    margin: 0 0 16px;
    font-size: 16px;
  }
  .notes-exit { margin: 8px 0 0; }
  .notes-exit a {
    color: var(--teal);
    text-decoration: none;
    font-size: 17px;
  }
  .notes-exit a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @keyframes notes-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }
  @media (max-width: 900px) {
    .notes .deck-3,
    .notes .deck-2,
    .notes .match-board { grid-template-columns: 1fr; }
    .notes { padding: 32px 20px 64px; }
    .notes .flip { height: 230px; min-height: 230px; }
  }
</style>

<script>
  const shuffle = (node) => {
    const cards = Array.from(node.children);
    for (let i = cards.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      node.appendChild(cards[j]);
      cards.splice(j, 1, cards[i]);
    }
  };
  document.querySelectorAll('[data-shuffle]').forEach(shuffle);

  const cycle = (card) => {
    const steps = Number(card.getAttribute('data-steps') || 2);
    const now = Number(card.getAttribute('data-step') || 0);
    card.setAttribute('data-step', String((now + 1) % steps));
  };

  document.querySelectorAll('.notes .flip:not(.match-card)').forEach((card) => {
    card.addEventListener('click', () => cycle(card));
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        cycle(card);
      }
    });
  });

  let pickedSit = null;
  let pickedMethod = null;
  const status = document.getElementById('matchStatus');

  const clearPicks = () => {
    document.querySelectorAll('.match-card.is-picked').forEach((el) => el.classList.remove('is-picked'));
    pickedSit = null;
    pickedMethod = null;
  };

  const tryMatch = () => {
    if (!pickedSit || !pickedMethod) return;
    const accept = (pickedSit.getAttribute('data-accept') || '').split(',');
    const methodId = pickedMethod.getAttribute('data-id');
    const ok = accept.includes(methodId);
    if (ok) {
      pickedSit.classList.add('is-paired');
      pickedMethod.classList.add('is-paired');
      const note = pickedSit.getAttribute('data-note');
      if (note && status) {
        status.hidden = false;
        status.textContent = note;
      }
      clearPicks();
    } else {
      pickedSit.classList.add('is-wrong');
      pickedMethod.classList.add('is-wrong');
      window.setTimeout(() => {
        pickedSit?.classList.remove('is-wrong');
        pickedMethod?.classList.remove('is-wrong');
        clearPicks();
      }, 420);
    }
  };

  document.querySelectorAll('.match-card').forEach((card) => {
    card.addEventListener('click', () => {
      if (card.classList.contains('is-paired')) return;
      const open = card.getAttribute('data-step') === '1';
      if (!open) {
        card.setAttribute('data-step', '1');
        return;
      }
      const role = card.getAttribute('data-role');
      if (role === 'sit') {
        document.querySelectorAll('.match-card[data-role="sit"].is-picked').forEach((el) => el.classList.remove('is-picked'));
        pickedSit = card;
      } else {
        document.querySelectorAll('.match-card[data-role="method"].is-picked').forEach((el) => el.classList.remove('is-picked'));
        pickedMethod = card;
      }
      card.classList.add('is-picked');
      tryMatch();
    });
  });
</script>

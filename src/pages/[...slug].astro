---
import { getAllRoutes, cleanTitle, pages, type PageEntry } from '../lib/pages';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/redesign.css';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return getAllRoutes().map(({ params, props }) => ({
    params,
    props: { page: props as PageEntry },
  }));
}

const { page } = Astro.props;
const htmlPath = path.join(process.cwd(), 'content/extracted', page.file);
let rawHtml = fs.readFileSync(htmlPath, 'utf-8');
const isHub = page.type === 'hub-custom';
const isArticle = page.type === 'article';
const title = cleanTitle(page.title);

if (!isHub) {
  rawHtml = rawHtml.replace(new RegExp(`^\\s*<h2>${title.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')}</h2>`, 'i'), '');
}

const headings = [...rawHtml.matchAll(/<h2[^>]*>([\s\S]*?)<\/h2>/gi)].map((m, i) => {
  const text = m[1].replace(/<[^>]+>/g, '').trim();
  const id = `s-${i + 1}`;
  return { id, text };
}).filter((h) => h.text && h.text.length < 120);

let bodyHtml = rawHtml;
let headingIndex = 0;
bodyHtml = bodyHtml.replace(/<h2([^>]*)>/gi, () => {
  const id = headings[headingIndex] ? headings[headingIndex].id : `s-${headingIndex + 1}`;
  headingIndex += 1;
  return `<h2 id="${id}">`;
});

const showToc = isArticle && headings.length >= 4;
const articles = pages.filter((p) => p.type === 'article' && p.status !== 'under-construction');
const idx = articles.findIndex((p) => p.url === page.url);
const prev = idx > 0 ? articles[idx - 1] : null;
const next = idx >= 0 && idx < articles.length - 1 ? articles[idx + 1] : null;
---

<BaseLayout title={title} description={page.description} hub={isHub}>
  {isHub ? (
    <Fragment set:html={rawHtml} />
  ) : isArticle ? (
    <article class="paper">
      <header class="paper-head">
        <h1>{title}</h1>
        {page.description && <p class="paper-dek">{page.description}</p>}
      </header>
      {showToc && (
        <nav class="paper-toc" aria-label="In this paper">
          {headings.map((h) => (
            <a href={`#${h.id}`}>{h.text}</a>
          ))}
        </nav>
      )}
      <div class="paper-body" set:html={bodyHtml} />
      <nav class="paper-pager" aria-label="More papers">
        {prev ? (
          <a class="pager-prev" href={prev.url}>
            <span>←</span>
            {cleanTitle(prev.title)}
          </a>
        ) : <span></span>}
        {next ? (
          <a class="pager-next" href={next.url}>
            {cleanTitle(next.title)}
            <span>→</span>
          </a>
        ) : <span></span>}
      </nav>
    </article>
  ) : (
    <div class="page page-redesign">
      <div class="page-header">
        <h1>{title}</h1>
        {page.description && <p class="page-lede">{page.description}</p>}
      </div>
      <div class="content-block" set:html={rawHtml} />
    </div>
  )}
</BaseLayout>

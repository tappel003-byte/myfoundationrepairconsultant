---
import { getAllRoutes, cleanTitle, pages, type PageEntry } from '../lib/pages';
import { getRelatedArticles } from '../lib/articleGroups';
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return getAllRoutes().map(({ params, props }) => ({
    params,
    props: { page: props as PageEntry },
  }));
}

const { page } = Astro.props;
const htmlPath = path.join(process.cwd(), 'content/extracted', page.file);
let rawHtml = fs.readFileSync(htmlPath, 'utf-8');
const isHub = page.type === 'hub-custom';
const isArticle = page.type === 'article';
const title = cleanTitle(page.title);

rawHtml = rawHtml
  .replace(/what-youre-seing/gi, 'what-youre-seeing')
  .replace(/<p class="is-empty is-editor-empty"><\/p>/g, '');

const dictPath = path.join(process.cwd(), 'content/extracted', 'foundation-repair-dictionary.html');
const dictHtml = fs.existsSync(dictPath) ? fs.readFileSync(dictPath, 'utf-8') : '';
const dictIds = new Set([...dictHtml.matchAll(/id="([a-z0-9-]+)"/g)].map((m) => m[1]));

const DICT_ALIASES: Record<string, string> = {
  'bond-strength': 'bond-strength',
  'load-path': 'load-path',
  'load-testing': 'load-testing',
  'geotechnical-investigation': 'geotechnical-investigation',
  'soil-report': 'soil-report',
  'micropile': 'micropile',
  'helical-pier': 'helical-pier',
  'push-pier': 'push-pier',
  'underpinning': 'underpinning',
  'bearing-capacity': 'bearing-capacity',
  'settlement': 'settlement',
  'differential-settlement': 'differential-settlement',
  'native-soil': 'native-soil',
  'fill': 'fill',
  'expansive-soil': 'expansive-soil',
  'collapsible-soil': 'collapsible-soil',
  'compaction': 'compaction',
};

function toDictId(label: string) {
  return label
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

function linkDictionaryLists(html: string) {
  return html.replace(
    /<(h2|h3)[^>]*>Related dictionary terms<\/\1>\s*<ul>([\s\S]*?)<\/ul>/gi,
    (full, _tag, list) => {
      const items = [...list.matchAll(/<li>([\s\S]*?)<\/li>/gi)].map((m) =>
        m[1].replace(/<[^>]+>/g, '').trim()
      );
      if (!items.length) return full;
      const linked = items
        .map((item) => {
          const id = DICT_ALIASES[toDictId(item)] || toDictId(item);
          return dictIds.has(id) || DICT_ALIASES[id]
            ? `<li><a href="/foundation-repair-dictionary#${id}">${item}</a></li>`
            : `<li>${item}</li>`;
        })
        .join('');
      return `<h2>Related dictionary terms</h2><ul class="dict-term-list">${linked}</ul>`;
    }
  );
}

if (!isHub) {
  rawHtml = rawHtml.replace(new RegExp(`^\\s*<h2>${title.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')}</h2>`, 'i'), '');
}

rawHtml = linkDictionaryLists(rawHtml);

const articles = pages.filter((p) => p.type === 'article' && !p.url.endsWith('-1'));
const unique = articles.filter((p, i, arr) => arr.findIndex((x) => x.url === p.url) === i);
const idx = unique.findIndex((p) => p.url === page.url);
const prev = idx > 0 ? unique[idx - 1] : null;
const next = idx >= 0 && idx < unique.length - 1 ? unique[idx + 1] : null;
const related = isArticle ? getRelatedArticles(page.url) : [];
---

<BaseLayout title={title} description={page.description} hub={isHub}>
  {isHub ? (
    <Fragment set:html={rawHtml} />
  ) : isArticle ? (
    <article class="paper">
      <div class="floating-nav" id="articleTopNav">
        <a href="#" id="articleTopLink" class="top-link"><span>↑</span> Top</a>
      </div>
      <header class="paper-head">
        <h1>{title}</h1>
      </header>
      <div class="paper-body" set:html={rawHtml} />
      {related.length > 0 && (
        <div class="paper-related">
          <h2>More on this topic</h2>
          <ul>
            {related.map((r) => (
              <li><a href={r.href}>{r.title}</a></li>
            ))}
          </ul>
        </div>
      )}
      <nav class="paper-pager" aria-label="More papers">
        {prev ? (
          <a class="pager-prev" href={prev.url}>
            <span>←</span>
            {cleanTitle(prev.title)}
          </a>
        ) : <span></span>}
        {next ? (
          <a class="pager-next" href={next.url}>
            {cleanTitle(next.title)}
            <span>→</span>
          </a>
        ) : <span></span>}
      </nav>
    </article>
  ) : (
    <div class="page page-redesign">
      <div class="page-header">
        <h1>{title}</h1>
        {page.description && <p class="page-lede">{page.description}</p>}
      </div>
      <div class="content-block" set:html={rawHtml} />
    </div>
  )}
</BaseLayout>

<script>
  const floatingNav = document.getElementById('articleTopNav');
  const head = document.querySelector('.paper-head');
  const topLink = document.getElementById('articleTopLink');

  if (floatingNav && head) {
    window.addEventListener('scroll', () => {
      floatingNav.classList.toggle('visible', window.scrollY > head.offsetHeight);
    });
    topLink?.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style is:global>
  .paper {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px 48px 80px;
  }
  .paper-head h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    margin: 0 0 36px;
  }
  .paper-body {
    font-size: 18px;
    line-height: 1.75;
  }
  .paper-body h2 {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 600;
    margin: 36px 0 14px;
    line-height: 1.25;
  }
  .paper-body h3 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 600;
    margin: 28px 0 12px;
    line-height: 1.3;
  }
  .paper-body p { margin: 0 0 16px; }
  .paper-body ul,
  .paper-body ol {
    margin: 12px 0 20px;
    padding-left: 1.4em;
  }
  .paper-body li { margin: 0 0 8px; }
  .paper-body a {
    color: #2d9499;
  }
  .paper-body .dict-term-list {
    display: block;
    list-style: disc;
    margin: 12px 0 20px;
    padding-left: 1.4em;
  }
  .paper-body .dict-term-list li {
    display: list-item;
    margin: 0 0 8px;
  }
  .paper-related {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid #e4e4e4;
  }
  .paper-related h2 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 14px;
  }
  .paper-related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .paper-related li {
    margin: 0 0 10px;
  }
  .paper-related a {
    color: #2d9499;
    font-size: 16px;
    line-height: 1.4;
  }
  .paper-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid #e4e4e4;
  }
  .paper-pager a {
    color: #1a1a1a;
    text-decoration: none;
    font-size: 17px;
    line-height: 1.35;
  }
  .paper-pager a:hover {
    color: #2d9499;
  }
  .pager-next { text-align: right; }
</style>

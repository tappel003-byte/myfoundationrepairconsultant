---
import { getAllRoutes, cleanTitle, pages, type PageEntry } from '../lib/pages';
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return getAllRoutes().map(({ params, props }) => ({
    params,
    props: { page: props as PageEntry },
  }));
}

const { page } = Astro.props;
const htmlPath = path.join(process.cwd(), 'content/extracted', page.file);
let rawHtml = fs.readFileSync(htmlPath, 'utf-8');
const isHub = page.type === 'hub-custom';
const isArticle = page.type === 'article';
const title = cleanTitle(page.title);

rawHtml = rawHtml
  .replace(/https:\/\/claude\.ai\/chat\/[^"#\s]+#([a-z0-9-]+)/gi, '#$1')
  .replace(/https:\/\/claude\.ai[^"\s<]*/gi, '/material-behavior')
  .replace(/what-youre-seing/gi, 'what-youre-seeing')
  .replace(/<p class="is-empty is-editor-empty"><\/p>/g, '');

const dictPath = path.join(process.cwd(), 'content/extracted', 'foundation-repair-dictionary.html');
const dictHtml = fs.existsSync(dictPath) ? fs.readFileSync(dictPath, 'utf-8') : '';
const dictIds = new Set([...dictHtml.matchAll(/id="([a-z0-9-]+)"/g)].map((m) => m[1]));

function toDictId(label: string) {
  return label
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

function linkDictionaryLists(html: string) {
  return html.replace(
    /<(h2|h3)[^>]*>Related dictionary terms<\/\1>\s*<ul>([\s\S]*?)<\/ul>/gi,
    (full, _tag, list) => {
      const items = [...list.matchAll(/<li>([\s\S]*?)<\/li>/gi)].map((m) =>
        m[1].replace(/<[^>]+>/g, '').trim()
      );
      if (!items.length) return full;
      const linked = items
        .map((item) => {
          const id = toDictId(item);
          return dictIds.has(id)
            ? `<li><a href="/foundation-repair-dictionary#${id}">${item}</a></li>`
            : `<li>${item}</li>`;
        })
        .join('');
      return `<h2>Related dictionary terms</h2><ul class="related-links">${linked}</ul>`;
    }
  );
}

if (!isHub) {
  rawHtml = rawHtml.replace(new RegExp(`^\\s*<h2>${title.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')}</h2>`, 'i'), '');
}

rawHtml = linkDictionaryLists(rawHtml);

const quoteMatch =
  rawHtml.match(/<div class="pull-quote"[\s\S]*?<p>([\s\S]*?)<\/p>/i) ||
  rawHtml.match(/<blockquote[\s\S]*?<p>([\s\S]*?)<\/p>/i);
const quote = quoteMatch
  ? quoteMatch[1].replace(/<[^>]+>/g, '').replace(/[\u201c\u201d"]/g, '').trim()
  : '';

if (quoteMatch) {
  rawHtml = rawHtml.replace(quoteMatch[0], '');
}

const headings = [...rawHtml.matchAll(/<h2[^>]*>([\s\S]*?)<\/h2>/gi)].map((m, i) => {
  const text = m[1].replace(/<[^>]+>/g, '').trim();
  const id = `s-${i + 1}`;
  return { id, text };
}).filter((h) => h.text && h.text.length < 120 && text !== 'Related dictionary terms');

let bodyHtml = rawHtml;
let headingIndex = 0;
bodyHtml = bodyHtml.replace(/<h2([^>]*)>/gi, () => {
  const id = headings[headingIndex] ? headings[headingIndex].id : `s-${headingIndex + 1}`;
  headingIndex += 1;
  return `<h2 id="${id}">`;
});

const showToc = isArticle && headings.length >= 4;
const articles = pages.filter((p) => p.type === 'article');
const unique = articles.filter((p, i, arr) => arr.findIndex((x) => x.url === p.url) === i);
const idx = unique.findIndex((p) => p.url === page.url);
const prev = idx > 0 ? unique[idx - 1] : null;
const next = idx >= 0 && idx < unique.length - 1 ? unique[idx + 1] : null;
---

<BaseLayout title={title} description={page.description} hub={isHub} quote={quote}>
  {isHub ? (
    <Fragment set:html={rawHtml} />
  ) : isArticle ? (
    <article class="paper">
      <header class="paper-head">
        <h1>{title}</h1>
        {page.description && page.description.trim() && !page.description.includes('under construction') && (
          <p class="paper-dek">{page.description}</p>
        )}
      </header>
      {showToc && (
        <nav class="paper-toc" aria-label="In this paper">
          {headings.map((h) => (
            <a href={`#${h.id}`}>{h.text}</a>
          ))}
        </nav>
      )}
      <div class="paper-body" set:html={bodyHtml} />
      <nav class="paper-pager" aria-label="More papers">
        {prev ? (
          <a class="pager-prev" href={prev.url}>
            <span>←</span>
            {cleanTitle(prev.title)}
          </a>
        ) : <span></span>}
        {next ? (
          <a class="pager-next" href={next.url}>
            {cleanTitle(next.title)}
            <span>→</span>
          </a>
        ) : <span></span>}
      </nav>
    </article>
  ) : (
    <div class="page page-redesign">
      <div class="page-header">
        <h1>{title}</h1>
        {page.description && <p class="page-lede">{page.description}</p>}
      </div>
      <div class="content-block" set:html={rawHtml} />
    </div>
  )}
</BaseLayout>

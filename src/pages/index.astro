---
// Homepage is Start Here
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const html = fs.readFileSync(
  path.join(process.cwd(), 'content/extracted/start-here.html'),
  'utf-8'
);
---

<BaseLayout
  title="Start Here"
  description="Independent foundation repair education for building owners. Understand cracks, settlement, and soil behavior before assuming the worst."
>
  <div class="page">
    <div class="page-header">
      <h1>Start Here</h1>
    </div>
    <div class="content-block" set:html={html} />
  </div>
</BaseLayout>

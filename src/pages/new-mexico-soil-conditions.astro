---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubPageShell from '../components/hub/HubPageShell.astro';
import soilsHtml from '../content/nm-soils-inner.html?raw';
---

<BaseLayout
  title="New Mexico Soil Conditions"
  description="Soil conditions and foundation hazards by New Mexico region. Sixteen basins, each with different soils, mechanisms, and investigation requirements."
  hub={true}
  quote="New Mexico does not have one foundation problem. It has sixteen starting points and thousands of variations. Understanding yours is where the conversation should begin."
>
  <HubPageShell
    title="New Mexico Soil Conditions"
    subhead="Sixteen basins"
    bannerBlurb="New Mexico spans sixteen geologically distinct basins, each with different soil conditions, different failure mechanisms, and different investigation requirements. These profiles explain what is actually in the ground."
    nav={[]}
    topicsStyle="none"
  >
    <div class="soils-page" set:html={soilsHtml} />
  </HubPageShell>
</BaseLayout>

<style is:global>
  .page-redesign:has(.soils-page) {
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }
  .soils-page {
    font-family: 'Source Serif 4', Georgia, serif;
  }
</style>

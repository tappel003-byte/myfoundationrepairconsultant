---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubPageShell from '../components/hub/HubPageShell.astro';
import { articleSchema } from '../lib/schema';
import extracted from '../../content/extracted/micropiles.html?raw';

const nav = [
  { id: 'what-they-are', label: 'What they are' },
  { id: 'load-transfer', label: 'How they transfer load' },
  { id: 'grouting-methods', label: 'Grouting methods' },
  { id: 'soil-type', label: 'Soil type & capacity' },
  { id: 'when-appropriate', label: 'When appropriate' },
  { id: 'investigation', label: 'Investigation requirements' },
  { id: 'installation', label: 'Installation process' },
  { id: 'building-owners', label: 'What owners should know' },
];

const pageDescription =
  'What micropiles are, how they transfer load through soil, when specific soil conditions make them appropriate, and what building owners should understand when evaluating recommendations — without sales pressure.';

const schema = articleSchema({
  headline: 'Micropiles',
  description: pageDescription,
  url: 'https://www.myfoundationrepairconsultant.com/micropiles',
});

function linkFirst(html: string, phrase: string, href: string) {
  const i = html.indexOf(phrase);
  if (i < 0) return html;
  return `${html.slice(0, i)}<a href="${href}">${phrase}</a>${html.slice(i + phrase.length)}`;
}

const bodyStart = extracted.indexOf('<!-- WHAT MICROPILES ARE');
let rest = bodyStart >= 0 ? extracted.slice(bodyStart).replace(/<\/div>\s*$/, '') : extracted;

rest = linkFirst(rest, 'the bond between grout and the surrounding ground', '/foundation-repair-dictionary#bond-strength');
rest = linkFirst(rest, 'Limited access', '/foundation-repair-dictionary#limited-access');
rest = linkFirst(rest, 'geotechnical investigation', '/foundation-repair-dictionary#geotechnical-investigation');
rest = linkFirst(rest, 'Load Testing', '/foundation-repair-dictionary#load-testing');
rest = linkFirst(rest, 'fill over native soil', '/foundation-repair-dictionary#fill');
---

<BaseLayout
  title="Micropiles"
  description={pageDescription}
  hub={true}
  quote="Understanding comes from seeing how many small pieces fit together."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  <HubPageShell
    title="Micropiles"
    subhead="What they are, how they work, and when specific soil conditions make them appropriate"
    bannerBlurb="This page explains what micropiles are, how they transfer load through soil, when specific soil conditions make them appropriate for foundation support, and what building owners should understand when evaluating recommendations—without sales pressure."
    description="This page is about what micropiles are, how they carry load through soil, and when documented soil conditions make them a reasonable option. Hearing the word on an estimate does not mean you need them."
    glance={[
      { label: 'Diameter', value: '3–12 inches' },
      { label: 'Capacity source', value: 'Grout-to-ground bond along shaft' },
      { label: 'Best for', value: 'Deep bearing, variable soils, limited access' },
      { label: 'Not for', value: 'High lateral loads without battering' },
    ]}
    nav={nav}
    topicsStyle="list"
  >
    <Fragment set:html={rest} />
    <h2 class="section-heading">Digging deeper</h2>
    <div class="deeper-grid">
      <div class="deeper-card">
        <h4><a href="/all-articles/grout-to-ground-bond-strength-in-different-soil-types">Grout-to-Ground Bond Strength in Different Soil Types</a></h4>
        <p>Published article</p>
      </div>
      <div class="deeper-card">
        <h4><a href="/all-articles/load-testing-and-verification-methods-for-micropiles">Load Testing and Verification Methods for Micropiles</a></h4>
        <p>Published article</p>
      </div>
      <div class="deeper-card">
        <h4><a href="/all-articles/grouting-pressure-and-quality-control">Grouting Pressure and Quality Control</a></h4>
        <p>Published article</p>
      </div>
      <div class="deeper-card">
        <h4><a href="/all-articles/micropile-design-calculations-and-engineering-requirements">Micropile Design Calculations and Engineering Requirements</a></h4>
        <p>Published article</p>
      </div>
    </div>
    <div class="related-links">
      <a href="/helical-piers">Helical Piers →</a>
      <a href="/push-piers">Push Piers →</a>
      <a href="/compaction-grouting">Compaction Grouting →</a>
      <a href="/foam-jacking">Foam Jacking →</a>
      <a href="/other-deep-foundations">Other Deep Foundations →</a>
      <a href="/foundation-repair-dictionary#bond-strength">Dictionary: Bond Strength →</a>
      <a href="/foundation-repair-dictionary#limited-access">Dictionary: Limited Access →</a>
    </div>
  </HubPageShell>
</BaseLayout>

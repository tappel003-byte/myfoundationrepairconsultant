---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubPageShell from '../components/hub/HubPageShell.astro';
import extracted from '../../content/extracted/common-signs.html?raw';

const nav = [
  { id: 'drywall', label: 'Drywall' },
  { id: 'concrete-interior', label: 'Concrete interior' },
  { id: 'exterior', label: 'Exterior walls' },
  { id: 'doors', label: 'Doors and windows' },
  { id: 'floors', label: 'Uneven floors' },
  { id: 'gaps', label: 'Gaps' },
  { id: 'corners', label: 'Corner separation' },
  { id: 'patterns', label: 'Patterns' },
  { id: 'observe', label: 'When to observe' },
  { id: 'evaluate', label: 'When to evaluate' },
];

const start = extracted.indexOf('<!-- DRYWALL');
const body = start >= 0 ? extracted.slice(start).replace(/<\/div>\s*$/, '') : extracted;
---

<BaseLayout
  title="Common Signs"
  description="What homeowners often notice — and what it usually means."
  hub={true}
  quote="A sign is something you can see. A cause is something you have to establish."
>
  <HubPageShell
    title="Common Signs"
    subhead="What homeowners often notice — and what it usually means"
    bannerBlurb="These observations are a starting point, not a conclusion. Noticing one or more of them does not automatically mean a foundation problem exists or that repair is needed."
    description="This page walks through the signs homeowners notice most often — drywall cracks, sticking doors, uneven floors — and what usually causes each one before jumping to foundation repair."
    glance={[
      { label: 'Drywall', value: 'Often shrinkage or seasonal change' },
      { label: 'Doors', value: 'Wood and humidity first' },
      { label: 'Floors', value: 'Watch for change over time' },
      { label: 'Pattern', value: 'Several signs in one area matter more' },
    ]}
    nav={nav}
    topicsStyle="list"
  >
    <Fragment set:html={body} />
    <div class="related-links">
      <a href="/material-behavior">Material behavior →</a>
      <a href="/start-here">Start Here →</a>
      <a href="/educational-articles">Educational articles →</a>
    </div>
  </HubPageShell>
</BaseLayout>

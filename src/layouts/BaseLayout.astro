---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/mfrc.css';
import '../styles/redesign.css';
import '../styles/dict-links.css';

interface Props {
  title: string;
  description?: string;
  hub?: boolean;
  quote?: string;
}

const {
  title,
  description = '',
  hub = false,
  quote = '',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/start-here';
const quotePages = new Set([
  '/start-here',
  '/educational-articles',
  '/repair-methods',
  '/micropiles',
  '/helical-piers',
  '/push-piers',
  '/compaction-grouting',
  '/foam-jacking',
  '/other-deep-foundations',
  '/foundation-field-notes',
]);
const shownQuote = quote && quotePages.has(path);

const fullTitle = title.includes('MFRC')
  ? title
  : `${title} — My Foundation Repair Consultant`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={`https://www.myfoundationrepairconsultant.com${path}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <meta property="og:site_name" content="My Foundation Repair Consultant" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
  </head>
  <body class={hub ? 'hub-layout' : 'article-layout'}>
    <SiteHeader />
    <main>
      <slot />
      {shownQuote && <p class="page-quote">{quote}</p>}
      <div class="page-end" aria-hidden="true"></div>
    </main>
  </body>
</html>

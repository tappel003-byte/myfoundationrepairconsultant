---
import SiteHeader from '../components/SiteHeader.astro';
import { articleSchema } from '../lib/schema';
import '../styles/mfrc.css';
import '../styles/redesign.css';
import '../styles/dict-links.css';
import '../styles/cabinet.css';
import '../styles/required-read.css';

interface Props {
  title: string;
  description?: string;
  hub?: boolean;
  quote?: string;
}

const {
  title,
  description = '',
  hub = false,
  quote = '',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/start-here';
const quotePages = new Set([
  '/start-here',
  '/educational-articles',
  '/repair-methods',
  '/micropiles',
  '/helical-piers',
  '/push-piers',
  '/compaction-grouting',
  '/foam-jacking',
  '/other-deep-foundations',
  '/foundation-field-notes',
  '/common-signs',
  '/material-behavior',
  '/foundation-types',
  '/how-the-industry-has-changed',
  '/new-mexico-soil-conditions',
  '/know-before-you-sign',
  '/foundation-behavior-in-arizona',
  '/foundation-behavior-in-new-mexico',
  '/investigate-further',
  '/investigate-further-arizona',
  '/all-articles',
]);
const shownQuote = quote && quotePages.has(path);

const ownSchema = new Set([
  '/start-here',
  '/repair-methods',
  '/micropiles',
  '/helical-piers',
  '/push-piers',
  '/compaction-grouting',
  '/foam-jacking',
  '/other-deep-foundations',
]);
const pageUrl = `https://www.myfoundationrepairconsultant.com${path}`;
const layoutSchema = !ownSchema.has(path)
  ? articleSchema({
      headline: title,
      description,
      url: pageUrl,
    })
  : null;

const fullTitle = title.includes('MFRC')
  ? title
  : `${title} — My Foundation Repair Consultant`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/jpeg" href="/MFRC%20Logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <meta property="og:site_name" content="My Foundation Repair Consultant" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {layoutSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(layoutSchema)} />
    )}
  </head>
  <body class={hub ? 'hub-layout' : 'article-layout'}>
    <SiteHeader />
    <main>
      <slot />
      {shownQuote && <p class="page-quote">{quote}</p>}
      <div class="page-end" aria-hidden="true"></div>
    </main>
  </body>
</html>
